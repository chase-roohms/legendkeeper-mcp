# Copy to .env (never commit .env). See README.md for every option.

# Required: a LegendKeeper API key (Project Settings -> Developers -> API Keys). Keys start with lk_.
LEGENDKEEPER_API_KEY=lk_your_key_here

# Optional: more worlds, each with its own key. The suffix becomes the project name ("homebrew").
# LEGENDKEEPER_API_KEY_HOMEBREW=lk_another_key
# LEGENDKEEPER_DEFAULT_PROJECT=default

# Optional: only expose reading tools.
# LEGENDKEEPER_READ_ONLY=true

# HTTP mode only: clients must send "Authorization: Bearer <token>". Generate with: openssl rand -hex 32
MCP_AUTH_TOKEN=change-me
